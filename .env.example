# MySQL Database - Required for Prisma
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Note: Encode special chars in password (e.g. # -> %23)
DATABASE_URL="mysql://user:password@host:3306/database_name"

# JWT (required for auth)
JWT_SECRET="your-jwt-secret"

# Email (for contact form, password reset, etc.)
EMAIL_USER=""
EMAIL_PASSWORD=""
CONTACT_EMAIL=""

# App URL
NEXT_PUBLIC_BASE_URL="https://yoursite.com"

# Cloudinary (for product images)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── FawryPay ────────────────────────────────────────────────────────
# SERVER-SIDE ONLY. Never prefix these with NEXT_PUBLIC_ — that would ship the
# secure key to every browser and let anyone forge a valid payment callback.
#
# Staging: https://atfawry.fawrystaging.com
# Production: https://www.atfawry.com
FAWRY_BASE_URL="https://atfawry.fawrystaging.com"
FAWRY_MERCHANT_CODE=""
FAWRY_SECURE_KEY=""

# Endpoint paths. Defaults suit most accounts; confirm against your integration
# email if the charge request comes back 404.
# FAWRY_INIT_PATH="/ECommerceWeb/api/payments/init"
# FAWRY_STATUS_PATH="/ECommerceWeb/Fawry/payments/status/v2"

# Shared secret for the cron endpoints, including Fawry reconciliation.
CRON_SECRET=""

# Fawry cash journal posting (tb_Journal / tb_JournalDet in the ERP).
# OFF until your accountant confirms the GL accounts — see
# docs/FAWRY_INTEGRATION.md, "Accounting". Payments are still fully recorded in
# tb_FawryPayments while this is off; only the ledger entry is skipped.
FAWRY_JOURNAL_ENABLED="false"
FAWRY_CASH_GL_ACCOUNT=""      # AccountTree.ID to DEBIT (where Fawry money lands)
FAWRY_REVENUE_GL_ACCOUNT=""   # AccountTree.ID to CREDIT
FAWRY_CASH_ID=""              # Cashes.ID stamped on the journal header
FAWRY_BRANCH_ID="10"
FAWRY_USER_ID="1"
