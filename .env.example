# MySQL Database - Required for Prisma
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Note: Encode special chars in password (e.g. # -> %23)
DATABASE_URL="mysql://user:password@host:3306/database_name"

# JWT (required for auth)
JWT_SECRET="your-jwt-secret"

# Email (for contact form, password reset, etc.)
EMAIL_USER=""
EMAIL_PASSWORD=""
CONTACT_EMAIL=""

# App URL
NEXT_PUBLIC_BASE_URL="https://yoursite.com"

# Cloudinary (for product images)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Redis — backs the sliding-window rate limiter in lib/rate-limit.ts.
# Unset, the limiter allows every request (local dev only).
REDIS_URL=""

# ── RAEY AI Try-On ──────────────────────────────────────────────────
# SERVER-SIDE ONLY. Never prefix any of these with NEXT_PUBLIC_ — the Gemini
# key must never reach a browser. The only client-facing surface is
# POST /api/ai/virtual-try-on.
GEMINI_API_KEY=""

# Gemini native image generation/editing model ("Nano Banana 2").
GEMINI_IMAGE_MODEL="gemini-3.1-flash-image"

# Master switch — set to "false" to hide the CTA and disable the endpoint.
AI_TRYON_ENABLED="true"

# Which collections show the TRY IT ON CTA. "*" (the default) means every
# dress — wedding, soiree, anything else — for both rent and buy. To narrow it,
# set a comma-separated list of ERP collection names, lowercase, e.g.
# "wedding,soiree". Enforced server-side as well as in the UI.
AI_TRYON_COLLECTIONS="*"

# Rate limits — enforced per IP in Redis (see REDIS_URL). Without Redis the
# limiter fails open, so set REDIS_URL in production.
AI_TRYON_MAX_REQUESTS_PER_MINUTE="2"
AI_TRYON_MAX_REQUESTS_PER_HOUR="8"
AI_TRYON_MAX_REQUESTS_PER_DAY="25"

# Upload / generation tuning (optional — sensible defaults in lib/ai/try-on-config.ts)
# AI_TRYON_MAX_UPLOAD_BYTES="12582912"   # 12 MB
# AI_TRYON_MAX_DIMENSION="1536"
# AI_TRYON_MIN_DIMENSION="256"
# AI_TRYON_JPEG_QUALITY="90"
# AI_TRYON_TIMEOUT_MS="90000"
# AI_TRYON_PROVIDER="gemini"

# ── RAEY AI Stylist ─────────────────────────────────────────────────
# Conversational bridal stylist + dress finder. Uses the same GEMINI_API_KEY
# above (server-side only) and the same CRON_SECRET for index maintenance.
AI_STYLIST_ENABLED="true"

# Conversation model. Needs strong Egyptian-Arabic/Arabizi ability and
# structured JSON output.
AI_STYLIST_MODEL="gemini-2.5-flash"

# Vision model used to catalogue gown photographs into style attributes.
# The ERP carries NO style metadata, so this index is what makes matching
# possible. Backfill it with:
#   curl -X POST "$SITE/api/ai/stylist/index?batch=25" -H "Authorization: Bearer $CRON_SECRET"
# repeat until the response reports remaining: 0. Check progress with GET.
AI_STYLIST_VISION_MODEL="gemini-2.5-flash"

# Where the derived index is written. Set an absolute path outside the
# deployment folder so it survives redeploys (same idea as UPLOAD_DIR).
# AI_STYLIST_INDEX_PATH="D:/raey-data/stylist-index.json"

# Rate limits, per IP (needs REDIS_URL — the limiter fails open without it).
AI_STYLIST_MAX_PER_MINUTE="12"
AI_STYLIST_MAX_PER_HOUR="120"

# Optional tuning
# AI_STYLIST_MIN_RESULTS="3"
# AI_STYLIST_MAX_RESULTS="5"
# AI_STYLIST_LAZY_TAG_BUDGET="3"   # background gowns catalogued per request
# AI_STYLIST_HISTORY_TURNS="12"
# AI_STYLIST_TIMEOUT_MS="45000"
# AI_STYLIST_MAX_MESSAGE_CHARS="1200"

# ── FawryPay ────────────────────────────────────────────────────────
# SERVER-SIDE ONLY. Never prefix these with NEXT_PUBLIC_ — that would ship the
# secure key to every browser and let anyone forge a valid payment callback.
#
# Staging: https://atfawry.fawrystaging.com
# Production: https://www.atfawry.com
FAWRY_BASE_URL="https://atfawry.fawrystaging.com"
FAWRY_MERCHANT_CODE=""
FAWRY_SECURE_KEY=""

# Endpoint paths. Defaults suit most accounts; confirm against your integration
# email if the charge request comes back 404.
# FAWRY_INIT_PATH="/ECommerceWeb/api/payments/init"
# FAWRY_STATUS_PATH="/ECommerceWeb/Fawry/payments/status/v2"
# FAWRY_REFUND_PATH="/ECommerceWeb/Fawry/payments/refund"

# Shared secret for the cron endpoints, including Fawry reconciliation.
CRON_SECRET=""

# Fawry cash journal posting (tb_Journal / tb_JournalDet in the ERP).
# OFF until your accountant confirms the GL accounts — see
# docs/FAWRY_INTEGRATION.md, "Accounting". Payments are still fully recorded in
# tb_FawryPayments while this is off; only the ledger entry is skipped.
FAWRY_JOURNAL_ENABLED="false"
FAWRY_CASH_GL_ACCOUNT=""      # AccountTree.ID to DEBIT (where Fawry money lands)
FAWRY_REVENUE_GL_ACCOUNT=""   # AccountTree.ID to CREDIT
FAWRY_CASH_ID=""              # Cashes.ID stamped on the journal header
FAWRY_BRANCH_ID="10"
FAWRY_USER_ID="1"
